{
  "color-fg": {
    "$type": "color",
    "$description": "Default body text color on color-bg. Passes WCAG AA (>7:1) for normal text.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.1216, 0.1608, 0.2157],
      "hex": "#1f2937"
    }
  },
  "color-bg": {
    "$type": "color",
    "$description": "Default page/surface background.",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    }
  },
  "color-surface": {
    "$type": "color",
    "$description": "Slightly recessed surface, used for chips and inputs.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.9647, 0.9725, 0.9882],
      "hex": "#f6f8fc"
    }
  },
  "color-fg-muted": {
    "$type": "color",
    "$description": "Secondary text, e.g. helper text and captions.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.4196, 0.4471, 0.502],
      "hex": "#6b7280"
    }
  },
  "color-primary": {
    "$type": "color",
    "$description": "Brand primary, used for primary actions and emphasis.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.1451, 0.3882, 0.9216],
      "hex": "#2563eb"
    }
  },
  "color-primary-hover": {
    "$type": "color",
    "$description": "Hover/active state of color-primary.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.1137, 0.3059, 0.8471],
      "hex": "#1d4ed8"
    }
  },
  "color-primary-fg": {
    "$type": "color",
    "$description": "Text/icon color on top of color-primary.",
    "$value": {
      "colorSpace": "srgb",
      "components": [1, 1, 1],
      "hex": "#ffffff"
    }
  },
  "color-border": {
    "$type": "color",
    "$description": "Default hairline border for cards, inputs, and dividers.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.8196, 0.8471, 0.898],
      "hex": "#d1d8e5"
    }
  },
  "color-danger": {
    "$type": "color",
    "$description": "Destructive actions and error states.",
    "$value": {
      "colorSpace": "srgb",
      "components": [0.8627, 0.149, 0.149],
      "hex": "#dc2626"
    }
  },
  "space-1": {
    "$type": "dimension",
    "$description": "Smallest spacing increment.",
    "$value": { "value": 4, "unit": "px" }
  },
  "space-2": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" }
  },
  "space-3": {
    "$type": "dimension",
    "$value": { "value": 12, "unit": "px" }
  },
  "space-4": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" }
  },
  "radius-sm": {
    "$type": "dimension",
    "$description": "Chips, small controls.",
    "$value": { "value": 4, "unit": "px" }
  },
  "radius-md": {
    "$type": "dimension",
    "$description": "Buttons, inputs.",
    "$value": { "value": 8, "unit": "px" }
  },
  "radius-lg": {
    "$type": "dimension",
    "$description": "Cards, modals.",
    "$value": { "value": 16, "unit": "px" }
  },
  "font-size-sm": {
    "$type": "dimension",
    "$value": { "value": 0.875, "unit": "rem" }
  },
  "font-size-md": {
    "$type": "dimension",
    "$value": { "value": 1, "unit": "rem" }
  },
  "font-size-lg": {
    "$type": "dimension",
    "$value": { "value": 1.25, "unit": "rem" }
  },
  "border-width-default": {
    "$type": "dimension",
    "$value": { "value": 1, "unit": "px" }
  },
  "font-family-base": {
    "$type": "fontFamily",
    "$value": "system-ui, -apple-system, 'Segoe UI', sans-serif"
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400
  },
  "font-weight-bold": {
    "$type": "fontWeight",
    "$value": 600
  },
  "line-height-base": {
    "$type": "number",
    "$value": 1.5
  },
  "shadow-sm": {
    "$type": "shadow",
    "$description": "Resting elevation for cards.",
    "$value": {
      "color": {
        "colorSpace": "srgb",
        "components": [0.1216, 0.1608, 0.2157],
        "hex": "#1f2937",
        "alpha": 0.08
      },
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 2, "unit": "px" },
      "blur": { "value": 8, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    }
  },
  "border-default": {
    "$type": "border",
    "$description": "Composite hairline border used by cards and inputs.",
    "$value": {
      "color": "{color-border}",
      "width": "{border-width-default}",
      "style": "solid"
    }
  },
  "button-primary-background": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-primary-background-hover": {
    "$type": "color",
    "$value": "{color-primary-hover}"
  },
  "button-primary-foreground": {
    "$type": "color",
    "$value": "{color-primary-fg}"
  },
  "button-primary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "button-secondary-background": {
    "$type": "color",
    "$value": "{color-bg}"
  },
  "button-secondary-foreground": {
    "$type": "color",
    "$value": "{color-primary}"
  },
  "button-secondary-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "button-secondary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },

  "card-default-background": {
    "$type": "color",
    "$value": "{color-bg}"
  },
  "card-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "card-default-radius": {
    "$type": "dimension",
    "$value": "{radius-lg}"
  },
  "card-default-padding": {
    "$type": "dimension",
    "$value": "{space-4}"
  },

  "chip-default-background": {
    "$type": "color",
    "$value": "{color-surface}"
  },
  "chip-default-foreground": {
    "$type": "color",
    "$value": "{color-fg-muted}"
  },
  "chip-default-radius": {
    "$type": "dimension",
    "$value": "{radius-sm}"
  },

  "input-default-background": {
    "$type": "color",
    "$value": "{color-bg}"
  },
  "input-default-border": {
    "$type": "color",
    "$value": "{color-border}"
  },
  "input-default-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "input-default-foreground": {
    "$type": "color",
    "$value": "{color-fg}"
  }
}
